/*
 * Rename tool styles (template) — registered with StylesheetBuilder.register_template() by
 * panel.py and appended after ui/theme/base.qss + widgets.qss. Same var()/alpha() syntax.
 */

TintedIcon#renameTitleIcon {
    qproperty-iconColor: var(--accent);
}
RenamePanel StableScrollArea#renameScroll {
    background-color: transparent;
    border: none;
}

/* The quick buttons: small, quiet, text — what they do is the tooltip. */
RenamePanel QuickButton#renameQuick {
    qproperty-iconColor: var(--text-primary);
}
RenamePanel QPushButton#renameQuick {
    color: var(--text-primary);
    background: alpha(var(--text-primary), 5%);
    border: 1px solid alpha(var(--border), 70%);
    border-radius: 5px;
    padding: 0px;
    min-width: 20px;
    max-width: 20px;
    min-height: 22px;
    max-height: 22px;
    font-size: 11px;
    font-weight: 600;
}
/* A quick GROUP (GroupButton): the action used last + a corner triangle that opens the rest. */
RenamePanel GroupButton#renameGroup {
    qproperty-iconColor: var(--text-primary);
    background: alpha(var(--text-primary), 5%);
    border: 1px solid alpha(var(--border), 70%);
    border-radius: 5px;
    padding: 0px 5px 0px 0px;
    min-width: 25px;
    max-width: 25px;
    min-height: 20px;
    max-height: 20px;
}
RenamePanel GroupButton#renameGroup:hover {
    border: 1px solid var(--accent);
    background: alpha(var(--accent), 12%);
}
RenamePanel GroupButton#renameGroup:pressed {
    background: alpha(var(--accent), 25%);
}
RenamePanel GroupButton#renameGroup[tone="blue"]   { qproperty-iconColor: var(--accent); }
RenamePanel GroupButton#renameGroup[tone="orange"] { qproperty-iconColor: var(--orange); }
RenamePanel GroupButton#renameGroup[tone="green"]  { qproperty-iconColor: var(--success); }
RenamePanel GroupButton#renameGroup[tone="teal"]   { qproperty-iconColor: var(--teal); }
/* Colored by group (panel.QUICK_TONES), the same hues as the strip beside the list. */
RenamePanel QuickButton#renameQuick[tone="blue"]   { qproperty-iconColor: var(--accent); }
RenamePanel QuickButton#renameQuick[tone="orange"] { qproperty-iconColor: var(--orange); }
RenamePanel QuickButton#renameQuick[tone="green"]  { qproperty-iconColor: var(--success); }
RenamePanel QuickButton#renameQuick[tone="teal"]   { qproperty-iconColor: var(--teal); }
RenamePanel QPushButton#renameQuick:hover {
    border: 1px solid var(--accent);
    background: alpha(var(--accent), 12%);
}
RenamePanel QPushButton#renameQuick:pressed {
    background: alpha(var(--accent), 25%);
}

/* Yes / no choices written as text (01, Aa, .*): switched on = the accent. */
RenamePanel QPushButton#renameToggle {
    color: var(--text-secondary);
    background: alpha(var(--text-primary), 5%);
    border: 1px solid alpha(var(--border), 70%);
    border-radius: 5px;
    padding: 0px 6px;
    min-height: 20px;
    max-height: 20px;
    font-size: 11px;
    font-weight: 700;
}
RenamePanel QPushButton#renameToggle:hover {
    border: 1px solid alpha(var(--accent), 60%);
}
RenamePanel QPushButton#renameToggle:checked {
    color: var(--accent);
    background: alpha(var(--accent), 18%);
    border: 1px solid alpha(var(--accent), 65%);
}

/* "+" beside the prefix / suffix fields, the side and kind buttons: framed like the fields. */
RenamePanel QPushButton#renameAdd,
RenamePanel QPushButton#renameKind,
RenamePanel QPushButton#renameSide {
    padding: 0px;
    min-height: 20px;
    max-height: 20px;
    font-size: 11px;
}
RenamePanel QPushButton#renameAdd {
    min-width: 22px;
    max-width: 22px;
    font-size: 14px;
    font-weight: 600;
}
RenamePanel QPushButton#renameKind {
    color: var(--text-secondary);
}
/* The sides the selection stands on, in Maya's colors for sides. */
RenamePanel SideButton {
    qproperty-leftColor:   var(--accent);
    qproperty-centerColor: var(--warning);
    qproperty-rightColor:  var(--error);
    qproperty-emptyColor:  alpha(var(--text-secondary), 30%);
}

RenamePanel QLineEdit#renameField {
    font-size: 12px;
}
RenamePanel QLabel#renameCaption {
    color: var(--text-secondary);
    font-size: 11px;
}
RenamePanel QLabel#renameCount {
    color: var(--text-secondary);
    font-size: 11px;
}
RenamePanel QLabel#renameSubtitle {
    color: var(--text-secondary);
    font-size: 9px;
    font-weight: 700;
}
RenamePanel QLabel#renameHint {
    color: var(--text-secondary);
    font-size: 10px;
}
RenamePanel QFrame#renameRule {
    background-color: alpha(var(--border), 70%);
    border: none;
}
/* Recipes: a framed icon button right of Rename; lit while the settings are one of them. */
RenamePanel QuickButton#renameRecipe {
    qproperty-iconColor: var(--text-secondary);
    background: alpha(var(--text-primary), 5%);
    border: 1px solid alpha(var(--border), 70%);
    border-radius: 5px;
    padding: 0px;
    min-width: 24px;
    max-width: 24px;
    min-height: 20px;
    max-height: 20px;
}
RenamePanel QuickButton#renameRecipe:hover {
    border: 1px solid alpha(var(--accent), 60%);
}
RenamePanel QuickButton#renameRecipe[on="true"] {
    qproperty-iconColor: var(--accent);
    background: alpha(var(--accent), 18%);
    border: 1px solid alpha(var(--accent), 65%);
}
/* On / off icon buttons (ToggleIconButton): off = quiet, on = the accent, clearly. */
RenamePanel ToggleIconButton#renameToggleIcon {
    qproperty-iconColor: var(--text-secondary);
    background: transparent;
    border: 1px solid transparent;
    border-radius: 5px;
    padding: 0px;
    min-width: 22px;
    max-width: 22px;
    min-height: 20px;
    max-height: 20px;
}
RenamePanel ToggleIconButton#renameToggleIcon:hover {
    border: 1px solid alpha(var(--accent), 60%);
}
RenamePanel ToggleIconButton#renameToggleIcon[on="true"] {
    qproperty-iconColor: var(--accent);
    background: alpha(var(--accent), 20%);
    border: 1px solid alpha(var(--accent), 70%);
}
RenamePanel GlyphButton#renameLock,
RenamePanel GlyphButton#renameInto {
    qproperty-glyphColor:       var(--text-secondary);
    qproperty-activeGlyphColor: var(--accent);
    qproperty-highlightColor:   alpha(var(--accent), 16%);
}

/* The hovered row's buttons (copy / into the field / show): a pill on the list's ground. */
RenamePanel QFrame#renameRowActions {
    background-color: var(--surface-raised);
    border: 1px solid alpha(var(--border), 80%);
    border-radius: 6px;
}
RenamePanel GlyphButton#renameRowAction {
    qproperty-glyphColor:       var(--text-secondary);
    qproperty-activeGlyphColor: var(--accent);
    qproperty-highlightColor:   alpha(var(--accent), 16%);
}
RenamePanel QLineEdit#renameListSearch {
    font-size: 11px;
}

/* The grip under the list: drag it to resize the list. */
RenamePanel HeightGrip {
    qproperty-gripColor: alpha(var(--text-secondary), 55%);
}
/* The kinds above the list: icon-only chips, the kind and count in the tooltip. */
RenamePanel ChipBar#renameKinds QPushButton#chip[text=""] {
    padding: 2px 7px;
}

/* Before -> after. */
RenamePanel PreviewList {
    qproperty-newColor:    var(--text-primary);
    qproperty-sameColor:   alpha(var(--text-secondary), 70%);
    qproperty-oldColor:    var(--text-secondary);
    qproperty-clashColor:  var(--warning);
    qproperty-errorColor:  var(--error);
    qproperty-lockedColor: alpha(var(--text-secondary), 70%);
    qproperty-changedColor: var(--accent);
    qproperty-dropColor:    var(--accent);
    qproperty-leftColor:    var(--accent);
    qproperty-rightColor:   var(--error);
    qproperty-midColor:     var(--yellow);
    qproperty-groundColor:  var(--field);
    qproperty-sameDotColor:       var(--warning);
    qproperty-badDotColor:        var(--error);
    qproperty-conventionDotColor: var(--accent);
    qproperty-shapeDotColor:      var(--teal);
    background-color: var(--field);
    border: 1px solid alpha(var(--border), 80%);
    border-radius: 6px;
    padding: 1px;
    font-size: 11px;
}
/* The tick of a row: renamed or left out (as the check boxes of base.qss). */
RenamePanel PreviewList::indicator {
    width: 12px;
    height: 12px;
    border-radius: 3px;
    border: 1px solid var(--border);
    background-color: linear-gradient(to bottom, var(--field-top), var(--field) 45%);
}
RenamePanel PreviewList::indicator:hover {
    border: 1px solid alpha(var(--accent), 55%);
}
/* A ticked row's tick shows only under the pointer (fewer marks in the list); an UNticked one
   always shows — what is left out must be seen. The room stays, so the names don't move. */
RenamePanel PreviewList::indicator:checked {
    background-color: transparent;
    border: 1px solid transparent;
    image: none;
}
RenamePanel PreviewList::indicator:checked:hover {
    background-color: linear-gradient(to bottom, var(--primary-top), var(--primary-bottom));
    border: 1px solid var(--primary-bottom);
    image: icon(actions/check, var(--on-accent));
}
RenamePanel PreviewList::item {
    padding: 1px 4px;
    border: none;
}
/* Rows picked in the list (a click, Ctrl / Shift+click): only they are renamed. */
RenamePanel PreviewList::item:selected {
    background: alpha(var(--accent), 20%);
    color: var(--text-primary);
}
RenamePanel PreviewList::item:hover {
    background: alpha(var(--accent), 8%);
}

RenamePanel QLabel#renameStatus                { color: var(--text-secondary); font-size: 11px; }
RenamePanel QLabel#renameStatus[state="done"]  { color: var(--success); }
RenamePanel QLabel#renameStatus[state="error"] { color: var(--error); }

/* QuickRename (quick_popup.py): the small field at the mouse pointer — a popup window of its own. */
QFrame#quickRenameFrame {
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
}
QLabel#quickRenameTitle {
    color: var(--text-secondary);
    font-size: 10px;
    font-weight: 700;
}
QLabel#quickRenamePreview {
    color: var(--text-primary);
    font-size: 11px;
}
QLabel#quickRenameHint {
    color: var(--text-secondary);
    font-size: 10px;
}

/* The word completion's list (word_fields.py): like our drop-down lists — our ground, rows tinted
   with the accent; a popup window of its own (adopted under its field), so square corners. */
QListView#wordCompleter {
    background-color: var(--surface-raised);
    color: var(--text-primary);
    border: 1px solid var(--border);
    padding: 3px;
    outline: 0;
}
QListView#wordCompleter::item {
    min-height: 20px;
    padding: 0px 6px;
    border-radius: 5px;
}
QListView#wordCompleter::item:hover {
    background-color: alpha(var(--accent), 12%);
}
QListView#wordCompleter::item:selected {
    background-color: alpha(var(--accent), 24%);
    color: var(--text-primary);
}

/* The strip beside the list: what to find, fix, lock. Each icon's COLOR says what it does
   (the `tone` property): find = the hue of what it finds, fix = success, lock = orange. */
RenamePanel QFrame#renameStripFrame {
    background: alpha(var(--text-primary), 3%);
    border: 1px solid alpha(var(--border), 60%);
    border-radius: 6px;
}
RenamePanel QFrame#renameStripLine {
    background: alpha(var(--border), 90%);
    border: none;   /* its size is set in code: a row while the list is empty */
}
RenamePanel StripButton#renameStrip {
    qproperty-iconColor: var(--text-primary);
    qproperty-badgeColor: var(--error);
    qproperty-badgeTextColor: var(--on-danger);
    qproperty-underColor: var(--text-secondary);
    background: transparent;
    border: 1px solid transparent;
    border-radius: 5px;
    padding: 0px;
    min-width: 24px;
    max-width: 24px;
    min-height: 24px;
    max-height: 24px;
}
RenamePanel StripButton#renameStrip:hover {
    background: alpha(var(--text-primary), 9%);
    border: 1px solid alpha(var(--border), 90%);
}
RenamePanel StripButton#renameStrip:pressed {
    background: alpha(var(--text-primary), 16%);
}
RenamePanel StripButton#renameStrip[tone="amber"]   { qproperty-iconColor: var(--warning); qproperty-badgeColor: var(--warning); }
RenamePanel StripButton#renameStrip[tone="red"]     { qproperty-iconColor: var(--error); }
RenamePanel StripButton#renameStrip[tone="violet"]  { qproperty-iconColor: var(--violet); }
RenamePanel StripButton#renameStrip[tone="teal"]    { qproperty-iconColor: var(--teal); }
RenamePanel StripButton#renameStrip[tone="orange"]  { qproperty-iconColor: var(--orange); qproperty-badgeColor: var(--orange); }
RenamePanel StripButton#renameStrip[tone="blue"]    { qproperty-iconColor: var(--accent); qproperty-badgeColor: var(--accent); }
RenamePanel StripButton#renameStrip[tone="green"]   { qproperty-iconColor: var(--success); }

/* The header: WORDS / FIND & REPLACE shown or hidden, the settings; what the panel says. */
RenameWindow ToggleIconButton#renameHeaderToggle {
    qproperty-iconColor: var(--text-secondary);
    background: transparent;
    border: 1px solid transparent;
    border-radius: 5px;
    padding: 0px;
    min-width: 24px;
    max-width: 24px;
    min-height: 22px;
    max-height: 22px;
}
RenameWindow ToggleIconButton#renameHeaderToggle:hover {
    background: alpha(var(--text-primary), 8%);
}
RenameWindow ToggleIconButton#renameHeaderToggle[on="true"] {
    qproperty-iconColor: var(--accent);
    background: alpha(var(--accent), 18%);
    border: 1px solid alpha(var(--accent), 55%);
}
RenameWindow GlyphButton#renameHeaderGear {
    qproperty-glyphColor:       var(--text-secondary);
    qproperty-activeGlyphColor: var(--accent);
    qproperty-highlightColor:   alpha(var(--accent), 16%);
}
RenameWindow QLabel#headerSubtitle[state="done"] {
    color: var(--success);
}
RenameWindow QLabel#headerSubtitle[state="error"] {
    color: var(--error);
}

/*
 * Playblast tool styles (template) — registered with
 * StylesheetBuilder.register_template() by panel.py and appended after
 * ui/theme/base.qss + widgets.qss. Same var()/alpha() syntax.
 */

PlayblastPanel StableScrollArea#playblastScroll {
    background-color: transparent;
    border: none;
}
PlayblastPanel QLabel#playblastTitle {
    color: var(--text-primary);
    font-size: 11px;
    font-weight: 700;
}
/* (also in the window's header) */
TintedIcon#playblastTitleIcon {
    qproperty-iconColor: var(--accent);
}
QLabel#playblastHint {
    color: var(--text-secondary);
    font-size: 11px;
}
PlayblastPanel QLabel#playblastCaption {
    color: var(--text-secondary);
}
PlayblastPanel QFrame#playblastCard {
    background-color: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: 9px;
}
PlayblastPanel QLabel#playblastSection {
    color: var(--text-secondary);
    font-size: 10px;
    font-weight: 700;
}
/* A size / frame field that only SHOWS what the named choice gives. */
PlayblastPanel QLineEdit[state="shown"] {
    color: var(--text-secondary);
    background: transparent;
    border: 1px solid alpha(var(--border), 60%);
}
PlayblastPanel IconPushButton#playblastStart {
    qproperty-iconColor: var(--on-accent);
    padding: 4px 12px;
}
/* VisibilityDialog (a window of its own: no PlayblastPanel above these) */
QLabel#visibilityGroup {
    color: var(--text-secondary);
    font-size: 10px;
    font-weight: 700;
}
QLabel#visibilityCaption {
    color: var(--text-secondary);
}
PlayblastPanel QLabel#playblastThumb {
    background-color: alpha(var(--text-primary), 6%);
    border-radius: 4px;
}
PlayblastPanel QLabel#playblastRecentName {
    color: var(--text-primary);
}
PlayblastPanel QLabel#playblastStatus               { color: var(--text-secondary); }
PlayblastPanel QLabel#playblastStatus[state="done"]  { color: var(--text-primary); }
PlayblastPanel QLabel#playblastStatus[state="error"] { color: var(--error); }
PlayblastPanel GlyphButton#playblastAction {
    qproperty-glyphColor:       var(--accent);
    qproperty-activeGlyphColor: var(--accent);
    qproperty-highlightColor:   alpha(var(--accent), 16%);
}

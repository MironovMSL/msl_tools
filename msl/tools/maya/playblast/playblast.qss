/*
 * Playblast tool styles (template) — registered with
 * StylesheetBuilder.register_template() by panel.py and appended after
 * ui/theme/base.qss + widgets.qss. Same var()/alpha() syntax.
 */

PlayblastPanel StableScrollArea#playblastScroll {
    background-color: transparent;
    border: none;
}
PlayblastPanel QLabel#playblastTitle {
    color: var(--text-primary);
    font-size: 11px;
    font-weight: 700;
}
/* (also in the window's header) */
TintedIcon#playblastTitleIcon {
    qproperty-iconColor: var(--accent);
}
QLabel#playblastHint {
    color: var(--text-secondary);
    font-size: 11px;
}
PlayblastPanel QLabel#playblastCaption {
    color: var(--text-secondary);
}
PlayblastPanel QFrame#playblastCard {
    background-color: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: 9px;
}
PlayblastPanel QLabel#playblastSection {
    color: var(--text-secondary);
    font-size: 10px;
    font-weight: 700;
}
/* A size / frame field that only SHOWS what the named choice gives. */
PlayblastPanel QLineEdit[state="shown"] {
    color: var(--text-secondary);
    background: transparent;
    border: 1px solid alpha(var(--border), 60%);
}
PlayblastPanel IconPushButton#playblastStart {
    qproperty-iconColor: var(--on-accent);
    padding: 4px 12px;
}
/* VisibilityDialog (a window of its own: no PlayblastPanel above these) */
QLabel#visibilityGroup {
    color: var(--text-secondary);
    font-size: 10px;
    font-weight: 700;
}
QLabel#visibilityCaption {
    color: var(--text-secondary);
}
/* A card's own icon, and the icons that stand for a row's caption. */
PlayblastPanel TintedIcon#playblastCardIcon {
    qproperty-iconColor: var(--accent);
}
PlayblastPanel TintedIcon#playblastRowIcon {
    qproperty-iconColor: var(--text-secondary);
}
/* A yes / no choice as a pill (_Toggle); `on` is set by the widget: qproperty-* is only
   applied from rules without pseudo-states, so not :checked. */
PlayblastPanel IconPushButton#playblastToggle {
    qproperty-iconColor: var(--text-secondary);
    color: var(--text-secondary);
    background: alpha(var(--text-primary), 5%);
    border: 1px solid alpha(var(--border), 70%);
    border-radius: 11px;
    padding: 2px 10px 2px 8px;
    min-height: 18px;
}
PlayblastPanel IconPushButton#playblastToggle:hover {
    border: 1px solid alpha(var(--accent), 60%);
}
PlayblastPanel IconPushButton#playblastToggle[on="true"] {
    qproperty-iconColor: var(--accent);
    color: var(--text-primary);
    background: alpha(var(--accent), 18%);
    border: 1px solid alpha(var(--accent), 65%);
}
PlayblastPanel IconPushButton#playblastToggle[bare="true"] {
    padding: 0px;
    border-radius: 6px;
    min-height: 0px;
}
/* The sketch of the mask: only its frame and marks are ours, the mask's colors are the user's. */
PlayblastPanel MaskPreview {
    qproperty-frameColor:  alpha(var(--text-primary), 8%);
    qproperty-borderColor: var(--border);
    qproperty-accentColor: var(--accent);
    qproperty-mutedColor:  var(--text-secondary);
}
/* RECENT: a result's picture, and the quiet "Clear" link. */
PlayblastPanel _Picture {
    qproperty-groundColor:   alpha(var(--text-primary), 8%);
    qproperty-markColor:     var(--on-accent);
    qproperty-hoverShadeColor: alpha(var(--chrome-background), 55%);   /* under the pointer, beneath the play mark */
    qproperty-menuIconColor: var(--text-secondary);   /* icons of its right-click menu */
}
PlayblastPanel QPushButton#playblastLink {
    color: var(--text-secondary);
    font-size: 11px;
}
PlayblastPanel QPushButton#playblastLink:hover {
    color: var(--accent);
}
PlayblastPanel QLabel#playblastRecentName {
    color: var(--text-primary);
}
PlayblastPanel QLabel#playblastRecentName:hover {
    color: var(--accent);
}
PlayblastPanel QLabel#playblastStatus               { color: var(--text-secondary); }
PlayblastPanel QLabel#playblastStatus[state="done"]  { color: var(--text-primary); }
PlayblastPanel QLabel#playblastStatus[state="error"] { color: var(--error); }
PlayblastPanel GlyphButton#playblastAction {
    qproperty-glyphColor:       var(--accent);
    qproperty-activeGlyphColor: var(--accent);
    qproperty-highlightColor:   alpha(var(--accent), 16%);
}

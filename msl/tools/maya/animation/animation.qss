/*
 * Animation tool styles (template) — registered with StylesheetBuilder.register_template() by
 * panel.py and appended after ui/theme/base.qss + widgets.qss. Same var()/alpha() syntax.
 * The sliders themselves (BlendSlider, tone pose = yellow / curve = green) are in widgets.qss.
 */

TintedIcon#animationTitleIcon {
    qproperty-iconColor: var(--accent);
}
AnimationPanel {
    qproperty-menuIconColor: var(--text-primary);
}

/* The button naming a slider's mode: quiet text, a colored edge on the side of its slider. */
AnimationPanel QPushButton#animationMode {
    text-align: left;
    padding-left: 6px;
    font-weight: 600;
}
AnimationPanel QPushButton#animationMode[tone="pose"] {
    border-left: 3px solid var(--yellow);
}
AnimationPanel QPushButton#animationMode[tone="curve"] {
    border-left: 3px solid var(--success);
}
AnimationPanel QPushButton#animationMode[tone="tangent"] {
    border-left: 3px solid var(--error);
}
AnimationPanel QPushButton#animationMode[tone="xform"] {
    border-left: 3px solid var(--pink);
}
AnimationPanel QPushButton#animationMode[tone="xform"][held="true"] {
    color: var(--pink);
    border-color: alpha(var(--pink), 70%);
}
AnimationPanel QPushButton#animationMode[tone="tangent"][held="true"] {
    color: var(--error);
    border-color: alpha(var(--error), 70%);
}
/* the held keys switch the mode for the next press: the button says so in its slider's color */
AnimationPanel QPushButton#animationMode[tone="pose"][held="true"] {
    color: var(--yellow);
    border-color: alpha(var(--yellow), 70%);
}
AnimationPanel QPushButton#animationMode[tone="curve"][held="true"] {
    color: var(--success);
    border-color: alpha(var(--success), 70%);
}

/* the mode's two letters in the mode menu (OptionMenu is a popup: no AnimationPanel above it) */
QLabel#animationModeChip {
    min-width: 26px;
    max-width: 26px;
    min-height: 18px;
    border-radius: 5px;
    font-size: 10px;
    font-weight: 700;
    color: var(--text-primary);
    background: var(--segment-pill);
}
QLabel#animationModeChip[tone="pose"] { border: 1px solid var(--yellow); }
QLabel#animationModeChip[tone="curve"] { border: 1px solid var(--success); }
QLabel#animationModeChip[tone="tangent"] { border: 1px solid var(--error); }
QLabel#animationModeChip[tone="xform"] { border: 1px solid var(--pink); }
AnimationPanel QLabel#animationCaption,
AnimationPanel QLabel#animationTargets {
    color: var(--text-secondary);
    font-size: 11px;
}
AnimationPanel QPushButton#animationQuiet {
    padding: 0px 8px;
}

ToggleIconButton#animationToggle {
    qproperty-iconColor: var(--text-secondary);
    background: transparent;
    border: 1px solid transparent;
    border-radius: 5px;
    padding: 0px;
    min-width: 24px;
}
ToggleIconButton#animationToggle:hover {
    border: 1px solid alpha(var(--accent), 60%);
}
ToggleIconButton#animationToggle[on="true"] {
    qproperty-iconColor: var(--accent);
    background: alpha(var(--accent), 20%);
    border: 1px solid alpha(var(--accent), 70%);
}

AnimationWindow GlyphButton#animationGear {
    qproperty-glyphColor:       var(--text-secondary);
    qproperty-activeGlyphColor: var(--accent);
    qproperty-highlightColor:   alpha(var(--accent), 16%);
}
AnimationPanel QLineEdit#animationNumber {
    padding: 0px 2px;
    font-size: 11px;
}

AnimationWindow QLabel#headerSubtitle[state="done"] { color: var(--success); }
AnimationWindow QLabel#headerSubtitle[state="error"] { color: var(--error); }

/* The tool groups (keys_row.py): a tinted block per group with a colored edge in its hue, its name in small
   capitals, then its tool buttons (the icon in the group's hue - a color key's own color in Color keys). */
QFrame#animationGroup {
    border-radius: 6px;
}
QLabel#animationGroupTitle {
    font-size: 9px;
    font-weight: 700;
    padding-right: 3px;
}
KeysRow QuickButton#animationTool {
    qproperty-iconColor: var(--text-primary);
    background: alpha(var(--text-primary), 5%);
    border: 1px solid alpha(var(--border), 70%);
    border-radius: 5px;
    padding: 0px 3px;
    font-size: 10px;
    font-weight: 600;
}
KeysRow QuickButton#animationTool:hover {
    border: 1px solid var(--accent);
    background: alpha(var(--accent), 12%);
}
KeysRow QuickButton#animationTool:pressed {
    background: alpha(var(--accent), 25%);
}
KeysRow QLineEdit#animationFrames {
    padding: 0px 2px;
}
QFrame#animationGroup[tone="teal"] { background: alpha(var(--teal), 7%); border-left: 3px solid alpha(var(--teal), 80%); }
QLabel#animationGroupTitle[tone="teal"] { color: var(--teal); }
KeysRow QuickButton#animationTool[tone="teal"] { qproperty-iconColor: var(--teal); }
QFrame#animationGroup[tone="blue"] { background: alpha(var(--accent), 7%); border-left: 3px solid alpha(var(--accent), 80%); }
QLabel#animationGroupTitle[tone="blue"] { color: var(--accent); }
KeysRow QuickButton#animationTool[tone="blue"] { qproperty-iconColor: var(--accent); }
QFrame#animationGroup[tone="violet"] { background: alpha(var(--violet), 7%); border-left: 3px solid alpha(var(--violet), 80%); }
QLabel#animationGroupTitle[tone="violet"] { color: var(--violet); }
KeysRow QuickButton#animationTool[tone="violet"] { qproperty-iconColor: var(--violet); }
QFrame#animationGroup[tone="orange"] { background: alpha(var(--orange), 7%); border-left: 3px solid alpha(var(--orange), 80%); }
QLabel#animationGroupTitle[tone="orange"] { color: var(--orange); }
KeysRow QuickButton#animationTool[tone="orange"] { qproperty-iconColor: var(--orange); }
QFrame#animationGroup[tone="red"] { background: alpha(var(--error), 7%); border-left: 3px solid alpha(var(--error), 80%); }
QLabel#animationGroupTitle[tone="red"] { color: var(--error); }
KeysRow QuickButton#animationTool[tone="red"] { qproperty-iconColor: var(--error); }
QFrame#animationGroup[tone="yellow"] { background: alpha(var(--yellow), 7%); border-left: 3px solid alpha(var(--yellow), 80%); }
QLabel#animationGroupTitle[tone="yellow"] { color: var(--yellow); }
KeysRow QuickButton#animationTool[tone="yellow"] { qproperty-iconColor: var(--yellow); }
QFrame#animationGroup[tone="green"] { background: alpha(var(--success), 7%); border-left: 3px solid alpha(var(--success), 80%); }
QLabel#animationGroupTitle[tone="green"] { color: var(--success); }
KeysRow QuickButton#animationTool[tone="green"] { qproperty-iconColor: var(--success); }
QFrame#animationGroup[tone="pink"] { background: alpha(var(--pink), 7%); border-left: 3px solid alpha(var(--pink), 80%); }
QLabel#animationGroupTitle[tone="pink"] { color: var(--pink); }
KeysRow QuickButton#animationTool[tone="pink"] { qproperty-iconColor: var(--pink); }

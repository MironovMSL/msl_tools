/*
 * Controls tool styles (template) — registered with StylesheetBuilder.register_template() by
 * panel.py and appended after ui/theme/base.qss + widgets.qss. Same var()/alpha() syntax.
 */

TintedIcon#controlsTitleIcon {
    qproperty-iconColor: var(--accent);
}
ControlsPanel StableScrollArea#controlsScroll {
    background-color: transparent;
    border: none;
}
ControlsPanel {
    qproperty-menuIconColor: var(--text-primary);
}
ControlsPanel QLabel#controlsCaption {
    color: var(--text-secondary);
    font-size: 11px;
}

/* The shapes: thumbnails in rows on a field; the picked one in the accent. */
ControlsPanel ShapeGrid#controlsGrid {
    qproperty-thumbColor: var(--text-primary);
    qproperty-starColor: var(--yellow);
    qproperty-starIdleColor: var(--text-secondary);
    qproperty-dropColor: var(--accent);
    background-color: var(--field);
    border: 1px solid alpha(var(--border), 80%);
    border-radius: 6px;
    padding: 2px;
}
ControlsPanel ShapeGrid#controlsGrid::item {
    border: 1px solid transparent;
    border-radius: 5px;
}
ControlsPanel ShapeGrid#controlsGrid::item:hover {
    background: alpha(var(--accent), 10%);
}
ControlsPanel ShapeGrid#controlsGrid::item:selected {
    background: alpha(var(--accent), 22%);
    border: 1px solid alpha(var(--accent), 70%);
}

/* The big preview that turns under the mouse. */
ControlsPanel ShapeView {
    qproperty-groundColor: var(--field);
    qproperty-gridColor:   var(--border);
    qproperty-lineColor:   var(--accent);
    qproperty-xColor:      var(--error);
    qproperty-yColor:      var(--success);
    qproperty-zColor:      var(--accent);
    qproperty-titleColor:  var(--text-secondary);
    qproperty-zeroColor:   var(--violet);
    qproperty-driveColor:  var(--pink);
}

/* Shape tools: small framed icon buttons, like Rename's quick ones. */
ControlsPanel QuickButton#controlsTool {
    qproperty-iconColor: var(--text-primary);
}
ControlsPanel QPushButton#controlsTool {
    color: var(--text-primary);
    background: alpha(var(--text-primary), 5%);
    border: 1px solid alpha(var(--border), 70%);
    border-radius: 5px;
    padding: 0px;
    min-width: 24px;
    max-width: 24px;
    min-height: 22px;
    max-height: 22px;
    font-size: 11px;
    font-weight: 600;
}
/* SELECTED: each group of buttons in its own color; a turn button in its axis' color. */
ControlsPanel QuickButton#controlsTool[tone="orange"] { qproperty-iconColor: var(--orange); }
ControlsPanel QuickButton#controlsTool[tone="blue"]   { qproperty-iconColor: var(--accent); }
ControlsPanel QuickButton#controlsTool[tone="teal"]   { qproperty-iconColor: var(--teal); }
ControlsPanel QuickButton#controlsTool[tone="violet"] { qproperty-iconColor: var(--violet); }
ControlsPanel QuickButton#controlsTool[tone="yellow"] { qproperty-iconColor: var(--yellow); }
ControlsPanel QuickButton#controlsTool[tone="green"]  { qproperty-iconColor: var(--success); }
ControlsPanel QuickButton#controlsTool[tone="pink"]   { qproperty-iconColor: var(--pink); }
ControlsPanel TurnButton#controlsTool[axis="X"] { qproperty-axisColor: var(--error); }
ControlsPanel TurnButton#controlsTool[axis="Y"] { qproperty-axisColor: var(--success); }
ControlsPanel TurnButton#controlsTool[axis="Z"] { qproperty-axisColor: var(--accent); }
ControlsPanel QFrame#controlsRule {
    background: alpha(var(--border), 90%);
    border: none;
}
/* The shape editor: the preview grown into the library's room. */
ControlsPanel EditorCanvas#controlsEditorCanvas {
    qproperty-groundColor: var(--field);
    qproperty-gridColor:   var(--border);
    qproperty-lineColor:   var(--accent);
    qproperty-pointColor:  var(--text-primary);
    qproperty-pickedColor: var(--orange);
    qproperty-pivotColor:  var(--text-secondary);
    qproperty-textColor:   var(--text-secondary);
    qproperty-xColor:      var(--error);
    qproperty-yColor:      var(--success);
    qproperty-zColor:      var(--accent);
}
/* The editor's numbers: an axis letter (a click lines the picked points up) and its field. */
ControlsPanel QPushButton#controlsAxis {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 5px;
    padding: 0px;
    min-width: 18px;
    max-width: 18px;
    min-height: 22px;
    max-height: 22px;
    font-size: 11px;
    font-weight: 600;
}
ControlsPanel QPushButton#controlsAxis:hover { border: 1px solid alpha(var(--accent), 60%); }
ControlsPanel QPushButton#controlsAxis[axis="X"] { color: var(--error); }
ControlsPanel QPushButton#controlsAxis[axis="Y"] { color: var(--success); }
ControlsPanel QPushButton#controlsAxis[axis="Z"] { color: var(--accent); }
/* One step along an axis: "−X" / "+X", framed like a tool, in the axis' color. */
ControlsPanel QPushButton#controlsAxisStep {
    background: alpha(var(--text-primary), 5%);
    border: 1px solid alpha(var(--border), 70%);
    border-radius: 5px;
    padding: 0px;
    min-width: 22px;
    max-width: 22px;
    min-height: 22px;
    max-height: 22px;
    font-size: 11px;
    font-weight: 600;
}
ControlsPanel QPushButton#controlsAxisStep:hover { border: 1px solid var(--accent); background: alpha(var(--accent), 12%); }
ControlsPanel QPushButton#controlsAxisStep:pressed { background: alpha(var(--accent), 25%); }
ControlsPanel QPushButton#controlsAxisStep[axis="X"] { color: var(--error); }
ControlsPanel QPushButton#controlsAxisStep[axis="Y"] { color: var(--success); }
ControlsPanel QPushButton#controlsAxisStep[axis="Z"] { color: var(--accent); }
/* The line under the library: zero groups › control ⇢ what it drives. */
ControlsPanel HierarchyStrip#controlsStrip {
    qproperty-zeroColor:    var(--violet);
    qproperty-controlColor: var(--accent);
    qproperty-driveColor:   var(--pink);
    qproperty-targetColor:  var(--text-secondary);
    qproperty-textColor:    var(--text-primary);
    qproperty-mutedColor:   var(--text-secondary);
}
/* The size of a new control, inside the preview's corner. */
ControlsPanel DragNumberField#controlsViewSize {
    min-height: 22px;
    max-height: 22px;
    padding: 0px 2px;
    font-size: 11px;
    border-radius: 5px;
}
ControlsPanel QPushButton#controlsTool:hover {
    border: 1px solid var(--accent);
    background: alpha(var(--accent), 12%);
}
ControlsPanel QPushButton#controlsTool:pressed {
    background: alpha(var(--accent), 25%);
}
/* Lit: it is already true of what is selected (tied, zeroed, on top). */
ControlsPanel QPushButton#controlsTool[on="true"] {
    background: alpha(var(--text-primary), 16%);
    border: 1px solid alpha(var(--text-primary), 75%);
}

/* On / off icon buttons: off = quiet, on = the accent. */
ControlsPanel ToggleIconButton#controlsToggle {
    qproperty-iconColor: var(--text-secondary);
    background: transparent;
    border: 1px solid transparent;
    border-radius: 5px;
    padding: 0px;
    min-width: 24px;
    max-width: 24px;
    min-height: 22px;
    max-height: 22px;
}
ControlsPanel ToggleIconButton#controlsToggle:hover {
    border: 1px solid alpha(var(--accent), 60%);
}
ControlsPanel ToggleIconButton#controlsToggle[on="true"] {
    qproperty-iconColor: var(--accent);
    background: alpha(var(--accent), 20%);
    border: 1px solid alpha(var(--accent), 70%);
}

ControlsPanel QPushButton#controlsCreate {
    padding: 0px 14px;
    min-height: 22px;
    max-height: 22px;
}

/* What the panel says, in the header: done = green, error = red. */
ControlsWindow QLabel#headerSubtitle[state="done"] {
    color: var(--success);
}
ControlsWindow QLabel#headerSubtitle[state="error"] {
    color: var(--error);
}

/* COLOR: the palette and the saved colors — the colors are the scene's; the ring and edge are ours. */
ControlsPanel Swatches {
    qproperty-ringColor: var(--accent);
    qproperty-edgeColor: alpha(var(--text-primary), 25%);
}
ControlsPanel ColorSwatchButton#controlsOwnColor {
    qproperty-borderColor: var(--border);
    qproperty-hoverBorderColor: var(--accent);
}

/* The header's buttons that show / hide a card (CHANNELS, ATTRIBUTES). */
ControlsWindow ToggleIconButton#controlsHeaderToggle {
    qproperty-iconColor: var(--text-secondary);
    background: transparent;
    border: 1px solid transparent;
    border-radius: 5px;
    padding: 0px;
    min-width: 24px;
    max-width: 24px;
    min-height: 22px;
    max-height: 22px;
}
ControlsWindow ToggleIconButton#controlsHeaderToggle:hover {
    background: alpha(var(--text-primary), 8%);
}
ControlsWindow ToggleIconButton#controlsHeaderToggle[on="true"] {
    qproperty-iconColor: var(--accent);
    background: alpha(var(--accent), 18%);
    border: 1px solid alpha(var(--accent), 55%);
}

/* CHANNELS: a channel is a button that shows its state. Open = the axis' color on a light fill;
   locked = the warning tone; locked and hidden = quiet and dashed; mixed = a dotted edge. */
ControlsPanel QPushButton#controlsChannel {
    padding: 0px;
    font-weight: 600;
    border-radius: 5px;
    border: 1px solid alpha(var(--accent), 55%);
    background: alpha(var(--accent), 16%);
    color: var(--text-primary);
}
ControlsPanel QPushButton#controlsChannel[axis="X"][state="open"] { color: var(--danger); border-color: alpha(var(--danger), 55%); background: alpha(var(--danger), 14%); }
ControlsPanel QPushButton#controlsChannel[axis="Y"][state="open"] { color: var(--success); border-color: alpha(var(--success), 55%); background: alpha(var(--success), 14%); }
ControlsPanel QPushButton#controlsChannel[axis="Z"][state="open"] { color: var(--accent); border-color: alpha(var(--accent), 55%); background: alpha(var(--accent), 14%); }
ControlsPanel QPushButton#controlsChannel[state="locked"] {
    color: var(--warning);
    border: 1px solid alpha(var(--warning), 70%);
    background: alpha(var(--warning), 14%);
}
ControlsPanel QPushButton#controlsChannel[state="hidden"] {
    color: alpha(var(--text-secondary), 70%);
    border: 1px dashed alpha(var(--text-secondary), 60%);
    background: transparent;
}
ControlsPanel QPushButton#controlsChannel[state="mixed"] {
    color: var(--text-secondary);
    border: 1px dotted var(--text-secondary);
    background: alpha(var(--text-secondary), 10%);
}
ControlsPanel QPushButton#controlsChannel:hover { border-color: var(--accent); }
ControlsPanel QPushButton#controlsChannel:disabled { color: alpha(var(--text-secondary), 50%); border-color: alpha(var(--border), 80%); background: transparent; }
ControlsPanel QPushButton#controlsChannelRow {
    color: var(--text-secondary);
    font-size: 11px;
    text-align: left;
    padding: 0px 2px;
    border: none;
    background: transparent;
}
ControlsPanel QPushButton#controlsChannelRow:hover { color: var(--accent); }
ControlsPanel QPushButton#controlsQuick {
    padding: 0px 8px;
    font-size: 11px;
}

/* ATTRIBUTES: each attribute is a row of widgets (attribute_rows.py). */
ControlsPanel AttributeRow {
    qproperty-gripColor: alpha(var(--text-secondary), 60%);
    qproperty-hoverColor: var(--accent);
    qproperty-selectedColor: var(--accent);
    qproperty-keyedColor: var(--danger);
    qproperty-drivenColor: var(--yellow);
    qproperty-mixedColor: var(--warning);
    qproperty-lineColor: alpha(var(--text-secondary), 90%);
}
ControlsPanel QLabel#controlsAttrName { color: var(--text-primary); }
ControlsPanel QLabel#controlsAttrName[quiet="true"] { color: alpha(var(--text-secondary), 80%); }
ControlsPanel QLabel#controlsAttrName[separator="true"] {
    color: var(--text-primary);
    font-weight: 700;
}
ControlsPanel ValueSlider#controlsAttrValue {
    qproperty-fieldColor: var(--field);
    qproperty-borderColor: alpha(var(--border), 90%);
    qproperty-fillColor: var(--accent);
    qproperty-textColor: var(--text-primary);
    qproperty-quietColor: alpha(var(--text-secondary), 80%);
}
ControlsPanel QLineEdit#controlsAttrEdit {
    min-height: 18px;
    padding: 0px 4px;
    border: 1px solid var(--accent);
    border-radius: 4px;
    background: var(--field);
    color: var(--text-primary);
}
/* K: keyable = lit, shown only = a quiet dot, hidden = a dash. */
ControlsPanel QPushButton#controlsAttrKey {
    padding: 0px;
    font-weight: 600;
    font-size: 11px;
    border-radius: 5px;
    border: 1px solid alpha(var(--border), 90%);
    background: transparent;
    color: var(--text-secondary);
}
ControlsPanel QPushButton#controlsAttrKey[state="key"] {
    color: var(--accent);
    border: 1px solid alpha(var(--accent), 55%);
    background: alpha(var(--accent), 16%);
}
ControlsPanel QPushButton#controlsAttrKey[state="hidden"] { border: 1px dashed alpha(var(--text-secondary), 55%); }
ControlsPanel QPushButton#controlsAttrKey:hover { border-color: var(--accent); }
ControlsPanel QuickButton#controlsAttrLock {
    qproperty-iconColor: alpha(var(--text-secondary), 70%);
    padding: 0px;
    border-radius: 5px;
    border: 1px solid alpha(var(--border), 90%);
    background: transparent;
}
ControlsPanel QuickButton#controlsAttrLock[on="true"] {
    qproperty-iconColor: var(--warning);
    border: 1px solid alpha(var(--warning), 70%);
    background: alpha(var(--warning), 14%);
}
ControlsPanel QuickButton#controlsAttrLock:hover { border-color: var(--accent); }
ControlsPanel QFrame#controlsAttrDrop { background: var(--accent); border: none; border-radius: 1px; }
ControlsPanel BaseComboBox#controlsAttrList { min-height: 20px; }
/* The small buttons beside a hovered row's name. */
ControlsPanel GlyphButton#controlsAttrQuick {
    qproperty-glyphColor:       var(--accent);
    qproperty-activeGlyphColor: var(--accent);
    qproperty-highlightColor:   alpha(var(--accent), 18%);
}

/* COLOR: where a color goes, said in words (an icon + its word; on = the accent). */
ControlsPanel ToggleIconButton#controlsWordToggle {
    qproperty-iconColor: var(--text-secondary);
    color: var(--text-secondary);
    background: transparent;
    border: 1px solid alpha(var(--border), 90%);
    border-radius: 5px;
    padding: 0px 8px 0px 6px;
    min-height: 22px;
    max-height: 22px;
}
ControlsPanel ToggleIconButton#controlsWordToggle:hover {
    border: 1px solid alpha(var(--accent), 60%);
}
ControlsPanel ToggleIconButton#controlsWordToggle[on="true"] {
    qproperty-iconColor: var(--accent);
    color: var(--text-primary);
    background: alpha(var(--accent), 20%);
    border: 1px solid alpha(var(--accent), 70%);
}
ControlsPanel QPushButton#controlsWordButton {
    padding: 0px 8px;
    font-size: 11px;
    font-weight: 600;
}

/* COLOR: the heading's marks — where the selection wears a color. */
ControlsPanel PlaceMark#controlsPlaceMark {
    qproperty-textColor: var(--text-primary);
    qproperty-quietColor: alpha(var(--text-secondary), 75%);
    qproperty-borderColor: alpha(var(--border), 90%);
    qproperty-warnColor: var(--warning);
    font-size: 11px;
}

/* TRANSFORMS: the grid of channels — taken (the axis' color), taken inverted (the warning tone, "−X"),
   left out (quiet and dashed). */
ControlsPanel QPushButton#controlsPick {
    padding: 0px;
    font-weight: 600;
    border-radius: 5px;
    border: 1px solid alpha(var(--accent), 55%);
    background: alpha(var(--accent), 14%);
    color: var(--text-primary);
}
ControlsPanel QPushButton#controlsPick[axis="X"][state="on"] { color: var(--danger); border-color: alpha(var(--danger), 55%); background: alpha(var(--danger), 14%); }
ControlsPanel QPushButton#controlsPick[axis="Y"][state="on"] { color: var(--success); border-color: alpha(var(--success), 55%); background: alpha(var(--success), 14%); }
ControlsPanel QPushButton#controlsPick[axis="Z"][state="on"] { color: var(--accent); border-color: alpha(var(--accent), 55%); background: alpha(var(--accent), 14%); }
ControlsPanel QPushButton#controlsPick[state="inv"] {
    color: var(--warning);
    border: 1px solid alpha(var(--warning), 75%);
    background: alpha(var(--warning), 16%);
}
ControlsPanel QPushButton#controlsPick[state="off"] {
    color: alpha(var(--text-secondary), 70%);
    border: 1px dashed alpha(var(--text-secondary), 60%);
    background: transparent;
}
ControlsPanel QPushButton#controlsPick:hover { border-color: var(--accent); }
ControlsPanel QLabel#controlsHint {
    color: var(--warning);
    font-size: 11px;
}

/* The header's layouts button. */
ControlsWindow GlyphButton#controlsHeaderGear {
    qproperty-glyphColor:       var(--text-secondary);
    qproperty-activeGlyphColor: var(--accent);
    qproperty-highlightColor:   alpha(var(--accent), 16%);
}

/* A group button of the SELECTED card (GroupButton): the corner triangle needs a little room. */
ControlsPanel GroupButton#controlsTool {
    padding: 0 6px 0 0;
}

/*
 * Media tool styles (template) — registered with
 * StylesheetBuilder.register_template() by page.py and appended after
 * ui/theme/base.qss + widgets.qss. Same var()/alpha() syntax.
 */

MediaPage QLabel#mediaTitle {
    color: var(--text-primary);
    font-weight: 600;
}
MediaPage QLabel#mediaSubtitle,
MediaPage QLabel#mediaCaption,
MediaPage QLabel#mediaHint,
MediaPage QLabel#mediaJobsEmpty {
    color: var(--text-secondary);
}
MediaPage QLabel#mediaHint {
    font-size: 11px;
}
/* The one action a source has (an image sequence: "To video"). */
MediaPage QLabel#mediaAction {
    color: var(--text-primary);
    font-weight: 600;
}
/* Quiet accent text buttons. */
MediaPage QPushButton#mediaLink {
    color: var(--accent);
    padding: 2px 6px;
    font-size: 11px;
}
MediaPage QPushButton#mediaLink:disabled {
    color: alpha(var(--text-secondary), 55%);
}

/* The line about ffmpeg: nothing to see while it is there, a notice while it isn't. */
MediaPage QFrame#mediaFfmpeg {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
}
MediaPage QFrame#mediaFfmpeg[state="missing"] {
    background-color: alpha(var(--warning), 12%);
    border: 1px solid alpha(var(--warning), 40%);
}
MediaPage QFrame#mediaFfmpeg[state="working"] {
    background-color: alpha(var(--accent), 8%);
    border: 1px solid alpha(var(--accent), 35%);
}
MediaPage QLabel#mediaFfmpegText {
    color: var(--text-primary);
}
MediaPage QFrame#mediaFfmpeg[state="looking"] QLabel#mediaFfmpegText {
    color: var(--text-secondary);
}

/* What is being worked on: while empty a DropArea (it paints its own dashed frame -
   ui/theme/widgets.qss), a raised card once loaded. */
MediaPage QFrame#mediaSource {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
}
MediaPage QFrame#mediaSource[look="loaded"] {
    background-color: var(--surface-raised);
    border: 1px solid var(--border);
}
/* Something is dragged over the page while a source is loaded: it would replace it. */
MediaPage QFrame#mediaSource[look="loaded"][dragging="true"] {
    background-color: alpha(var(--accent), 9%);
    border: 1px dashed var(--accent);
}
MediaPage QLabel#mediaThumbnail {
    background-color: alpha(var(--text-primary), 8%);
    color: var(--text-secondary);
    border-radius: 4px;
    font-size: 11px;
}
MediaPage QLabel#mediaSourceTitle {
    color: var(--text-primary);
    font-weight: 600;
}
MediaPage QLabel#mediaSourceFacts {
    color: var(--text-secondary);
}
MediaPage QLabel#mediaSourceWarning {
    color: var(--warning);
}
/* Several sources: the line under the facts lists their names - not a warning. */
MediaPage QLabel#mediaSourceWarning[plain="true"] {
    color: var(--text-secondary);
    font-size: 11px;
}

/* The small icon buttons beside the start button (preview, command) and in a job's row. */
MediaPage GlyphButton#mediaAction {
    qproperty-glyphColor:       var(--accent);
    qproperty-activeGlyphColor: var(--accent);
    qproperty-highlightColor:   alpha(var(--accent), 16%);
}

/* About how big / how long: a quiet pill at the start of the row with the start button. */
MediaPage QLabel#mediaEstimate {
    color: var(--text-primary);
    background-color: alpha(var(--text-primary), 7%);
    border-radius: 10px;
    padding: 2px 10px;
    font-size: 11px;
}

/* The source's facts: a small tile each - the value over what it is. */
MediaPage QFrame#mediaFact {
    background-color: alpha(var(--text-primary), 5%);
    border: 1px solid alpha(var(--border), 60%);
    border-radius: 6px;
}
MediaPage QLabel#mediaFactValue {
    color: var(--text-primary);
    font-size: 12px;
    font-weight: 600;
}
MediaPage QLabel#mediaFactCaption {
    color: var(--text-secondary);
    font-size: 10px;
}
/* The source's picture under the pointer: dimmed, with a play mark. */
MediaPage SourceThumbnail {
    qproperty-overlayColor: alpha(var(--surface), 45%);
    qproperty-markColor:    var(--accent);
    qproperty-symbolColor:  var(--on-accent);
}

/* A card: a block of the page raised off it, with a header line (an accent icon and a
   title in capitals) - the picked action with everything that belongs to it, the jobs. */
MediaPage QFrame#mediaCard {
    background-color: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: 9px;
}
MediaPage QLabel#mediaCardTitle {
    color: var(--text-primary);
    font-size: 11px;
    font-weight: 700;
}
MediaPage TintedIcon#mediaCardIcon {
    qproperty-iconColor: var(--accent);
}
MediaPage QFrame#mediaDivider {
    background-color: alpha(var(--border), 70%);
    border: none;
}
/* An action's settings sit in the action's card: no frame of their own. */
MediaPage QFrame#mediaOptions {
    background-color: transparent;
    border: none;
}

MediaPage QLabel#mediaMessage                { color: var(--text-secondary); }
MediaPage QLabel#mediaMessage[state="error"] { color: var(--error); }

/* The jobs. */
MediaPage StableScrollArea#mediaJobs {
    background-color: transparent;
    border: none;
}
MediaPage QFrame#mediaJob {
    border: none;
    border-bottom: 1px solid alpha(var(--border), 45%);
}
MediaPage QLabel#mediaJobTitle {
    color: var(--text-primary);
}
/* A finished job's title is its result file: click to open, drag to take it somewhere. */
MediaPage QLabel#mediaJobTitle[link="true"]:hover {
    color: var(--accent);
}
MediaPage QLabel#mediaJobStatus {
    color: var(--text-secondary);
    font-size: 11px;
}
MediaPage QLabel#mediaJobStatus[state="failed"] { color: var(--error); }
MediaPage QLabel#mediaJobDot {
    background-color: alpha(var(--text-secondary), 60%);
    border-radius: 4px;
}
MediaPage QLabel#mediaJobDot[state="running"]   { background-color: var(--accent); }
MediaPage QLabel#mediaJobDot[state="done"]      { background-color: var(--success); }
MediaPage QLabel#mediaJobDot[state="failed"]    { background-color: var(--error); }
MediaPage QLabel#mediaJobDot[state="cancelled"] {
    background-color: transparent;
    border: 1px solid var(--text-secondary);
}

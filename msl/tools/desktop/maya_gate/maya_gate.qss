/*
 * Maya Gate tool styles (template) — registered with
 * StylesheetBuilder.register_template() by variable_group.py and appended
 * after ui/theme/base.qss + widgets.qss. Same var()/alpha() syntax.
 */

/* Toolbar captions ("Environment", "From"): dimmed, the controls carry the weight. */
/* "EN" — English in Maya, per environment: on = the accent (the `on` property: qproperty-* can't
   come from :checked). */
MayaGateToolbar IconPushButton#gateEnglish {
    qproperty-iconColor: var(--text-secondary);
    color: var(--text-secondary);
    background: alpha(var(--text-primary), 5%);
    border: 1px solid alpha(var(--border), 70%);
    border-radius: 6px;
    padding: 0px 8px 0px 6px;
    font-size: 11px;
    font-weight: 600;
}
MayaGateToolbar IconPushButton#gateEnglish:hover {
    border: 1px solid alpha(var(--accent), 60%);
}
MayaGateToolbar IconPushButton#gateEnglish[on="true"] {
    qproperty-iconColor: var(--accent);
    color: var(--accent);
    background: alpha(var(--accent), 16%);
    border: 1px solid alpha(var(--accent), 65%);
}
MayaGateToolbar QLabel#toolbarCaption {
    color: var(--text-secondary);
}

MayaVersionRow QLabel#versionRowEmpty {
    color: var(--text-secondary);
}

/* userSetup tab: title like a group header, a status that says where the script stands. */
UserSetupTab QLabel#userSetupTitle {
    color: var(--text-primary);
    font-weight: 600;
}
UserSetupTab QLabel#userSetupSection,
UserSetupTab QLabel#userSetupStatus {
    color: var(--text-secondary);
}
UserSetupTab QLabel#userSetupStatus[state="editing"] { color: var(--accent); }
UserSetupTab QLabel#userSetupStatus[state="off"]     { color: var(--warning); }
UserSetupTab QLabel#userSetupStatus[state="error"]   { color: var(--error); font-weight: 600; }
UserSetupTab QLabel#userSetupHint {
    color: var(--text-secondary);
    font-size: 11px;
}
/* Icon + text buttons: IconPushButton zeroes the padding for icon-only use. */
UserSetupTab IconPushButton {
    padding: 3px 10px 3px 8px;
}

/* Icons of a version's right-click menu. */
MayaGatePage {
    qproperty-menuIconColor: var(--text-secondary);
}
/* Sessions tab: the Mayas running right now. */
SessionsTab {
    qproperty-menuIconColor:   var(--text-secondary);   /* icons of a row's menu */
    qproperty-menuDangerColor: var(--danger);           /* ... of its "Close Maya" */
}
SessionsTab QLabel#sessionsTitle {
    color: var(--text-primary);
    font-weight: 600;
}
SessionsTab QLabel#sessionsSummary,
SessionsTab QLabel#sessionsStatus,
SessionsTab QLabel#sessionsEmpty,
SessionsTab QLabel#sessionTime {
    color: var(--text-secondary);
}
SessionsTab QLabel#sessionsStatus,
SessionsTab QLabel#sessionsHint,
SessionsTab QLabel#sessionTime {
    font-size: 11px;
}
SessionsTab QLabel#sessionsStatus[state="error"] {
    color: var(--error);
}
SessionsTab QLabel#sessionsHint {
    color: var(--text-secondary);
}
SessionsTab StableScrollArea#sessionsScroll {
    background-color: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: 6px;
}
/* What can be asked of a running Maya: quiet accent links. */
SessionsTab QPushButton#sessionAction {
    color: var(--accent);
    padding: 2px 6px;
    font-size: 11px;
}
SessionsTab QPushButton#sessionAction:disabled {
    color: alpha(var(--text-secondary), 55%);
}
/* A console snippet: a small pill - one click runs it. */
SessionsTab QPushButton#snippetChip {
    color: var(--text-primary);
    background: alpha(var(--text-primary), 8%);
    border: 1px solid transparent;
    border-radius: 9px;
    padding: 0px 9px;
    min-height: 18px;
    max-height: 18px;
    font-size: 11px;
}
SessionsTab QPushButton#snippetChip:hover {
    background: alpha(var(--accent), 18%);
    border-color: alpha(var(--accent), 55%);
}
SessionsTab QPushButton#snippetChip:pressed {
    background: alpha(var(--accent), 30%);
}
/* An on / off switch among the quiet links ("Wrap"): dimmed while off. */
SessionsTab QPushButton#sessionToggle {
    color: var(--text-secondary);
    padding: 2px 6px;
    font-size: 11px;
}
SessionsTab QPushButton#sessionToggle:hover {
    color: var(--text-primary);
}
SessionsTab QPushButton#sessionToggle:checked {
    color: var(--accent);
}
/* The caption of the sessions that are over: a click folds / unfolds them. */
SessionsTab QPushButton#sessionsHistoryToggle {
    color: var(--text-secondary);
    padding: 2px 4px;
    text-align: left;
}
SessionsTab QPushButton#sessionsHistoryToggle:hover {
    color: var(--text-primary);
}
/* The last request's outcome, under the list. */
SessionsTab QLabel#sessionsMessage                  { color: var(--text-secondary); }
SessionsTab QLabel#sessionsMessage[state="success"] { color: var(--success); }
SessionsTab QLabel#sessionsMessage[state="error"]   { color: var(--error); }
/* The selected session (its log is shown below). */
SessionsTab QWidget#sessionRow[selected="true"] {
    background-color: alpha(var(--accent), 12%);
    border-radius: 5px;
}
/* How many errors / warnings a Maya printed: small pills in the tone. */
SessionsTab QLabel#sessionErrors,
SessionsTab QLabel#sessionWarnings {
    border-radius: 7px;
    padding: 0px 6px;
    min-height: 14px;
    max-height: 14px;
    font-size: 11px;
    font-weight: 600;
}
SessionsTab QLabel#sessionErrors {
    color: var(--error);
    background-color: alpha(var(--error), 16%);
}
SessionsTab QLabel#sessionWarnings {
    color: var(--warning);
    background-color: alpha(var(--warning), 16%);
}
/* A connected Maya: a green dot. */
SessionsTab QLabel#sessionDot {
    background-color: var(--success);
    border-radius: 4px;
}
SessionsTab QLabel#sessionDot[state="busy"]  { background-color: var(--warning); }
SessionsTab QLabel#sessionDot[state="ended"] { background-color: var(--error); }
/* A session that is over and closed normally: a hollow dot. */
SessionsTab QLabel#sessionDot[state="closed"] {
    background-color: transparent;
    border: 1px solid var(--text-secondary);
}
/* "busy": a small pill in the warning tone. */
SessionsTab QLabel#sessionBusy {
    color: var(--warning);
    background-color: alpha(var(--warning), 16%);
    border-radius: 7px;
    padding: 0px 6px;
    min-height: 14px;
    max-height: 14px;
    font-size: 11px;
}
SessionsTab QLabel#sessionEnded {
    color: var(--error);
}
SessionsTab QLabel#sessionVersion {
    color: var(--text-primary);
    font-weight: 600;
}
SessionsTab QLabel#sessionScene {
    color: var(--text-primary);
}
/* The scene's name is a link to the file. */
SessionsTab QLabel#sessionScene[hover="true"] {
    color: var(--accent);
}
/* Sessions that are over read quieter than the running ones. */
SessionsTab QLabel#sessionVersion[past="true"],
SessionsTab QLabel#sessionScene[past="true"],
SessionsTab QLabel#sessionOutcome {
    color: var(--text-secondary);
}
SessionsTab QLabel#sessionVersion[past="true"] {
    font-weight: 400;
}
SessionsTab QLabel#sessionScene[past="true"][hover="true"] {
    color: var(--accent);
}
SessionsTab QLabel#sessionOutcome {
    font-size: 11px;
}
SessionsTab QLabel#sessionOutcome[state="error"] {
    color: var(--error);
}
/* Environment / boost: small pills (boost in the accent). */
SessionsTab QLabel#sessionEnvironment,
SessionsTab QLabel#sessionBoost {
    color: var(--text-secondary);
    background-color: alpha(var(--text-primary), 8%);
    border-radius: 7px;
    padding: 0px 6px;
    min-height: 14px;
    max-height: 14px;
    font-size: 11px;
}
SessionsTab QLabel#sessionBoost {
    color: var(--accent);
    background-color: alpha(var(--accent), 15%);
}

/* Boost start tab: a titled list of Maya's auto-load plug-ins. */
BoostTab QLabel#boostTitle {
    color: var(--text-primary);
    font-weight: 600;
}
BoostTab QLabel#boostSection,
BoostTab QLabel#boostSummary,
BoostTab QLabel#boostEmpty {
    color: var(--text-secondary);
}
BoostTab QLabel#boostTiming {
    color: var(--text-secondary);
}
BoostTab QLabel#boostHint {
    color: var(--text-secondary);
    font-size: 11px;
}
BoostTab QPushButton {
    padding: 3px 10px;
}
/* The list is a panel like the variable groups. */
BoostTab StableScrollArea#boostScroll {
    background-color: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: 6px;
}
BoostTab QLabel#boostName:disabled {
    color: alpha(var(--text-secondary), 70%);
}
/* A heavy family's icon reads stronger than the generic plug. */
BoostTab TintedIcon[family="true"] {
    qproperty-iconColor: var(--text-primary);
}
/* A plug-in's heavy family: a small neutral pill; its load time: dimmed numbers. */
BoostTab QLabel#boostFamily {
    color: var(--text-secondary);
    background-color: alpha(var(--text-primary), 8%);
    border-radius: 7px;
    padding: 0px 6px;
    min-height: 14px;
    max-height: 14px;
    font-size: 11px;
}
BoostTab QLabel#boostTime {
    color: var(--text-secondary);
    font-size: 11px;
}
BoostTab QLabel#boostTime[state="error"] {
    color: var(--error);
}
/* Boost can't work here / Maya's own list shrank. */
BoostTab QFrame#boostNoticeFrame {
    background-color: alpha(var(--warning), 12%);
    border: 1px solid alpha(var(--warning), 40%);
    border-radius: 6px;
}
BoostTab QLabel#boostNotice {
    color: var(--text-primary);
}

/* Groups are panels raised off the page card; their fields sit back in (--field).
   The header tints on hover (it folds the group) and is ruled off from the rows. */
CollapsibleVariableGroup {
    qproperty-frameColor:       var(--border);
    qproperty-fillColor:        var(--surface-raised);
    qproperty-headerHoverColor: alpha(var(--text-primary), 5%);
    qproperty-dividerColor:     alpha(var(--border), 60%);
}
CollapsibleVariableGroup QLabel#groupTitle {
    color: var(--text-primary);
    font-weight: 600;
}
CollapsibleVariableGroup QLabel#groupSection {
    color: var(--text-secondary);
}
/* Row count: a small accent pill. */
CollapsibleVariableGroup QLabel#groupCount {
    color: var(--accent);
    background-color: alpha(var(--accent), 15%);
    border-radius: 7px;
    padding: 0px 6px;
    min-height: 14px;
    max-height: 14px;
    font-size: 11px;
    font-weight: 600;
}

/* The handle between the log and the console: the gap between them (QSplitter.setHandleWidth),
   nothing painted until the pointer is on it — then a soft accent bar. (A splitter handle takes
   neither margin, padding nor background-clip: a hairline or a short grip can't be made in QSS;
   whatever is painted fills the whole handle.) */
SessionsTab QSplitter#sessionsSplit::handle:vertical {
    background-color: transparent;
}
SessionsTab QSplitter#sessionsSplit::handle:vertical:hover,
SessionsTab QSplitter#sessionsSplit::handle:vertical:pressed {
    background-color: alpha(var(--accent), 55%);
}

/* What to check before a launch (MayaGatePage): a quiet warning link under the versions. */
QPushButton#gateProblems {
    color: var(--warning);
    font-size: 11px;
}
QPushButton#gateProblems:hover {
    color: var(--text-primary);
}

/*
 * Scenes tool styles (template) — registered with StylesheetBuilder.register_template() by
 * page.py. The tabs' own pages keep theirs (batch.qss, scene_paths.qss).
 */

ScenesPage QLabel#scenesTitle {
    color: var(--text-primary);
    font-size: 11px;
    font-weight: 700;
}
ScenesPage TintedIcon#scenesTitleIcon {
    qproperty-iconColor: var(--accent);
}
ScenesPage QLabel#scenesSubtitle {
    color: var(--text-secondary);
}

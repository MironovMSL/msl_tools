/*
 * msl_tools custom-widget styles (template) — appended after base.qss.
 *
 * Custom-painted widgets expose their colors as Qt properties
 * (ui/theme/qss.py:color_property); `qproperty-<name>` sets them. Qt re-applies
 * these on every stylesheet change, so theme switches and hot reload repaint
 * these widgets with no set_theme() calls.
 *
 * State lives in dynamic properties selected with [name="value"]; widgets
 * call repolish() after changing one.
 *
 * Type selectors are Python class names and also match subclasses
 * (a BaseCheckbox rule styles every BaseCheckbox subclass).
 */

/* --- window buttons (frameless header: minimize / maximize / close) --------- */

BaseNavButton {
    qproperty-iconColor:      var(--text-primary);
    qproperty-hoverIconColor: var(--text-primary);
    qproperty-hoverColor:     alpha(var(--text-primary), 10%);
    qproperty-pressedColor:   alpha(var(--text-primary), 16%);
}
/* Close: the conventional destructive red, white icon on it. */
CloseNavButton {
    qproperty-hoverIconColor: var(--on-danger);
    qproperty-hoverColor:     var(--danger);
    qproperty-pressedColor:   var(--danger-pressed);
}

/* --- UpdateButton (header): "an update is available" ------------------------ */

UpdateButton {
    qproperty-iconColor:    var(--accent);
    qproperty-ringColor:    alpha(var(--accent), 50%);
    qproperty-hoverColor:   alpha(var(--accent), 16%);
    qproperty-pressedColor: alpha(var(--accent), 28%);
}

/* --- GlyphButton ------------------------------------------------------------ */

GlyphButton {
    qproperty-glyphColor:            var(--text-secondary);
    qproperty-activeGlyphColor:      var(--text-primary);
    qproperty-highlightColor:        alpha(var(--text-primary), 11%);
    qproperty-pressedHighlightColor: alpha(var(--text-primary), 21.6%);
}
/* A destructive action (bulk delete): red while hovered / pressed. */
GlyphButton[danger="true"] {
    qproperty-activeGlyphColor:      var(--danger);
    qproperty-highlightColor:        alpha(var(--danger), 13%);
    qproperty-pressedHighlightColor: alpha(var(--danger), 24%);
}

/* --- SegmentedControl: sunken track, raised pill that slides ------------------ */

SegmentedControl {
    qproperty-trackTopColor:    var(--segment-track-top);
    qproperty-trackColor:       var(--segment-track);
    qproperty-borderColor:      var(--border);
    qproperty-pillTopColor:     var(--segment-pill-top);
    qproperty-pillColor:        var(--segment-pill);
    qproperty-pillBorderColor:  var(--border);
    qproperty-textColor:        var(--text-secondary);
    qproperty-hoverTextColor:   var(--text-primary);
    qproperty-activeTextColor:  var(--text-primary);
}

/* --- BaseTabBar: painted indicator that slides between tabs ------------------ */

BaseTabBar {
    qproperty-indicatorColor: var(--accent);
}
/* The indicator is painted; the tab keeps only the transparent 2px as its room. */
BaseTabBar::tab:selected {
    border-bottom: 2px solid transparent;
}

/* --- BaseComboBox: painted, animated arrow (turns up while the list is open) --- */

BaseComboBox {
    qproperty-arrowColor:      var(--text-secondary);
    qproperty-arrowHoverColor: var(--text-primary);
    qproperty-arrowOpenColor:  var(--accent);
}
/* The widget paints the arrow itself; keep base.qss's arrow SIZE (it sets the
   SC_ComboBoxArrow rect the painting uses), drop its image. */
BaseComboBox::down-arrow,
BaseComboBox::down-arrow:hover,
BaseComboBox::down-arrow:on,
BaseComboBox::down-arrow:disabled {
    image: none;
}

/* --- SlimScrollBar: painted handle, same colors as base.qss's QScrollBar::handle --- */

SlimScrollBar {
    qproperty-handleColor:        alpha(var(--text-primary), 22%);
    qproperty-handleHoverColor:   alpha(var(--text-primary), 38%);
    qproperty-handlePressedColor: alpha(var(--accent), 75%);
}

/* --- IconPushButton: framed button with a QSS-tinted one-color icon ------------ */

IconPushButton {
    qproperty-iconColor: var(--text-primary);
    padding: 0px;   /* the base 4px 10px leaves no room for an icon in a ~26px button */
}

/* --- ApplicationButton: app tile (icon over name), card on hover ------------ */

ApplicationButton {
    qproperty-hoverColor:       alpha(var(--text-primary), 6%);
    qproperty-hoverBorderColor: alpha(var(--border), 70%);
}
/* The icon is the tile's picture, not a framed button. */
ApplicationButton QToolButton {
    background: transparent;
    border: none;
    padding: 0px;
}
ApplicationButton QLabel#appName {
    color: var(--text-primary);
    font-weight: 600;
}
ApplicationButton QLabel#appName[busy="true"] {
    color: var(--accent);
}

/* --- BaseCheckbox ------------------------------------------------------------ */

/* Unchecked = sunken like a line edit; checked = the primary button's gradient. */
BaseCheckbox {
    qproperty-boxColor:         var(--field);
    qproperty-boxTopColor:      var(--field-top);
    qproperty-borderColor:      var(--border);
    qproperty-hoverBorderColor: alpha(var(--accent), 55%);
    qproperty-fillColor:        var(--primary-bottom);
    qproperty-fillTopColor:     var(--primary-top);
    qproperty-checkmarkColor:   var(--on-accent);
    qproperty-textColor:        var(--text-primary);
}

/* --- BaseProgressBar: chunk color per `state` -------------------------------- */

BaseProgressBar::chunk                  { background-color: var(--accent); }
BaseProgressBar[state="success"]::chunk { background-color: var(--success); }
BaseProgressBar[state="error"]::chunk   { background-color: var(--error); }

/* --- VersionStatusWidget: status color per `status` -------------------------- */

VersionStatusWidget QLabel#versionPrefix {
    color: var(--text-secondary);
    font-size: 12px;
}
VersionStatusWidget QLabel#versionValue,
VersionStatusWidget QLabel#versionStatus {
    color: var(--text-primary);
    font-size: 13px;
    font-weight: 600;
}
VersionStatusWidget QLabel#versionStatus[status="up_to_date"]       { color: var(--success); }
VersionStatusWidget QLabel#versionStatus[status="update_available"] { color: var(--warning); }
VersionStatusWidget QLabel#versionStatus[status="not_installed"]    { color: var(--text-secondary); }
VersionStatusWidget QLabel#versionStatus[status="unknown"]          { color: var(--error); }

/* --- BasePathWidget ------------------------------------------------------------ */

BasePathWidget QLabel#pathLabel {
    color: var(--text-secondary);
}

/* --- HubWindow sidebar ----------------------------------------------------------- */

/* Tiles (icon over a small label) on the window chrome, with volume from vertical gradients (--nav-*):
   idle = flat, hover = a faint raised pill, pressed flips the gradient (lit
   from below) and the bevel, so the pill looks pushed in. The OPEN tool's
   pill — lit from above, its bottom fading into the page card — is painted
   by HubSidebar under the tiles (so it can slide between them); the checked
   tile itself stays transparent.
   Idle keeps a transparent 1px border so entries don't shift on hover.
   Icons (IconPushButton) follow the text: secondary, primary on the open
   tool. That's a dynamic property, not :checked — Qt applies qproperty-*
   only from rules without pseudo-states. */
IconTileButton#hubNavButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 10px;
    padding: 7px 2px 5px 2px;
    font-size: 11px;
    color: var(--text-secondary);
    qproperty-iconColor: var(--text-secondary);
}
IconTileButton#hubNavButton[current="true"] {
    qproperty-iconColor: var(--text-primary);
}
IconTileButton#hubNavButton:hover {
    background-color: linear-gradient(to bottom, var(--nav-top-hover), var(--nav-bottom-hover));
    border-color: alpha(var(--nav-edge-bottom), 40%);
    border-top-color: alpha(var(--nav-edge-top), 40%);
    color: var(--text-primary);
}
IconTileButton#hubNavButton:checked {
    background-color: transparent;
    border: 1px solid transparent;
    color: var(--text-primary);
    font-weight: 600;
}
HubSidebar {
    qproperty-pillTopColor:        var(--nav-top);
    qproperty-pillColor:           var(--nav-bottom);
    qproperty-pillEdgeTopColor:    var(--nav-edge-top);
    qproperty-pillEdgeBottomColor: var(--nav-edge-bottom);
}
/* Version under the tools: a quiet text button (opens "What's new"). */
QPushButton#hubFooter {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 2px 4px;
    color: alpha(var(--text-secondary), 80%);
    font-size: 10px;
}
QPushButton#hubFooter:hover {
    background-color: alpha(var(--text-primary), 7%);
    border: 1px solid transparent;
    color: var(--text-primary);
}
/* An update is out (HubWindow.set_footer_notice()). */
QPushButton#hubFooter[notice="true"] {
    color: var(--accent);
    font-weight: 600;
}
QPushButton#hubFooter:pressed {
    background-color: alpha(var(--text-primary), 12%);
    border: 1px solid transparent;
    color: var(--text-primary);
}
IconTileButton#hubNavButton:pressed {
    background-color: linear-gradient(to top, var(--nav-top-hover), var(--nav-bottom-hover));
    border-color: var(--nav-edge-top);
    border-top-color: var(--nav-edge-bottom);
    color: var(--text-primary);
}

/* --- ConfirmDialog (ui/widgets/windows/confirm_dialog.py) ----------------------- */

ConfirmDialog QLabel#confirmMessage {
    color: var(--text-primary);
    font-weight: 600;
}
ConfirmDialog QLabel#confirmDetails {
    color: var(--text-secondary);
}
/* The badge's tone follows the dialog's kind. */
ConfirmDialog ToneBadge                  { qproperty-toneColor: var(--accent); }
ConfirmDialog[kind="warning"] ToneBadge  { qproperty-toneColor: var(--warning); }
ConfirmDialog[kind="danger"] ToneBadge   { qproperty-toneColor: var(--danger); }
/* The primary choice is a QPushButton[primary="true"] (base.qss); in a
   "danger" dialog also [danger="true"] — red. */

/* --- WhatsNewDialog (ui/widgets/windows/whats_new_dialog.py) -------------------- */

WhatsNewDialog QLabel#releaseDate {
    color: var(--text-primary);
    font-size: 14px;
    font-weight: 600;
}
WhatsNewDialog QLabel#releaseTitle {
    color: var(--text-secondary);
}
/* Version pill (a button: opens the release's page): neutral; accent for
   versions newer than the installed one, green for the installed one. */
WhatsNewDialog QPushButton#releaseVersion {
    color: var(--text-secondary);
    background-color: alpha(var(--text-primary), 8%);
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 1px 7px;
    font-size: 11px;
}
WhatsNewDialog QPushButton#releaseVersion:hover {
    border: 1px solid alpha(var(--text-primary), 30%);
}
WhatsNewDialog QPushButton#releaseVersion[state="new"] {
    color: var(--accent);
    background-color: alpha(var(--accent), 15%);
}
WhatsNewDialog QPushButton#releaseVersion[state="new"]:hover {
    border: 1px solid alpha(var(--accent), 55%);
}
WhatsNewDialog QPushButton#releaseVersion[state="current"] {
    color: var(--success);
    background-color: alpha(var(--success), 15%);
}
WhatsNewDialog QPushButton#releaseVersion[state="current"]:hover {
    border: 1px solid alpha(var(--success), 55%);
}
WhatsNewDialog QLabel#releaseBullet {
    color: var(--text-secondary);
}
/* "A newer version is out" banner above the list. */
WhatsNewDialog QFrame#updateBanner {
    background-color: alpha(var(--accent), 12%);
    border: 1px solid alpha(var(--accent), 35%);
    border-radius: 6px;
}
WhatsNewDialog QLabel#updateText {
    color: var(--text-primary);
}
WhatsNewDialog QLabel#releaseSection {
    color: var(--text-secondary);
    font-size: 11px;
    font-weight: 600;
}
WhatsNewDialog QLabel#releaseBody {
    color: var(--text-primary);
}
WhatsNewDialog QWidget#releaseDivider {
    background-color: alpha(var(--border), 55%);
}
WhatsNewDialog QLabel#whatsNewStatus {
    color: var(--text-secondary);
}
WhatsNewDialog QPushButton#whatsNewLink {
    color: var(--accent);
    padding: 2px 6px;
}

/* --- compositions ------------------------------------------------------------------ */

/* Card behind the item being dragged (DraggableList drag cursor image). */
DraggableList {
    qproperty-dragBackgroundColor: var(--surface-raised);
    qproperty-dragBorderColor:     alpha(var(--accent), 60%);
}

/* Selection strip: one accent-tinted pill. */
BulkActionBar {
    qproperty-pillColor:       alpha(var(--accent), 12%);
    qproperty-pillBorderColor: alpha(var(--accent), 35%);
}
BulkActionBar QLabel#bulkCount {
    color: var(--accent);
    font-weight: 600;
}
BulkActionBar QWidget#bulkDivider {
    background-color: alpha(var(--accent), 35%);
}

/* Setup window (tools/desktop/installer): what happened / what to do. */
QLabel#installerMessage                    { color: var(--text-secondary); }
QLabel#installerMessage[state="success"]   { color: var(--success); }
QLabel#installerMessage[state="warning"]   { color: var(--warning); }
QLabel#installerMessage[state="error"]     { color: var(--error); }

InstallPathWidget QLabel#installHint {
    color: var(--text-secondary);
    font-size: 11px;
}

EnvVarRow {
    qproperty-selectedColor: alpha(var(--accent), 14.9%);
    qproperty-hoverColor:    alpha(var(--text-primary), 4%);
}
/* A value whose folder doesn't exist on disk (the tooltip says which):
   warning border, also on hover — the accent returns while typing. */
EnvVarRow QLineEdit[pathState="missing"],
EnvVarRow QLineEdit[pathState="missing"]:hover {
    border: 1px solid var(--warning);
}
EnvVarRow QLineEdit[pathState="missing"]:focus {
    border: 1px solid var(--accent);
}

/* --- CodeEditor ------------------------------------------------------------------ */

/* The writing area is the deepest surface: a "well" set into the page.
   Syntax colors come from the palettes' --syntax-* tokens; focus takes the
   accent border like a line edit. */
CodeEditor {
    background-color: var(--editor-background);
    color: var(--text-primary);
    border: 1px solid var(--border);
    border-radius: 3px;
    selection-background-color: alpha(var(--accent), 40%);
    selection-color: var(--text-primary);

    qproperty-keywordColor:           var(--syntax-keyword);
    qproperty-constantColor:          var(--syntax-constant);
    qproperty-selfColor:              var(--syntax-self);
    qproperty-builtinColor:           var(--syntax-builtin);
    qproperty-definitionColor:        var(--syntax-function);
    qproperty-decoratorColor:         var(--syntax-decorator);
    qproperty-numberColor:            var(--syntax-number);
    qproperty-stringColor:            var(--syntax-string);
    qproperty-commentColor:           var(--syntax-comment);
    qproperty-lineNumberColor:        alpha(var(--text-secondary), 65%);
    qproperty-currentLineNumberColor: var(--text-primary);
    qproperty-gutterDividerColor:     alpha(var(--border), 60%);
    qproperty-currentLineColor:       alpha(var(--text-primary), 5%);
    qproperty-errorLineColor:         alpha(var(--error), 16%);
    qproperty-errorNumberColor:       var(--error);
}
CodeEditor:focus {
    border: 1px solid var(--accent);
}
